{
  "name": "rawclaw",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-start.mjs",
    "build": "cross-env TURBO_FORCE_GIT=0 turbo run build",
    "lint": "cross-env TURBO_FORCE_GIT=0 turbo run lint",
    "test": "cross-env TURBO_FORCE_GIT=0 turbo run test",
    "check-types": "cross-env TURBO_FORCE_GIT=0 turbo run check-types",
    "chat:cli": "node scripts/chat-cli.mjs",
    "verify:chat": "node scripts/chat-capability-check.mjs",
    "verify:system": "node scripts/system-verification.mjs",
    "verify:system:live": "node scripts/system-verification.mjs --live-web"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "^2.0.0"
  }
}
