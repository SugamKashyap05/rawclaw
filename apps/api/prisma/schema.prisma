// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Session {
  id               String    @id @default(cuid())
  title            String?
  metadataJson     String?
  workspaceId      String    @default("default")
  senderIdentifier String    @default("local")
  surfaceType      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]
  binding          SessionBinding?

  @@index([workspaceId])
  @@map("sessions")
}

model SessionBinding {
  id                String    @id @default(cuid())
  routingKey        String    @unique
  sessionId         String    @unique
  workspaceId       String
  senderIdentifier  String
  surfaceType       String    @default("chat")
  threadKey         String?
  channelKey        String?
  agentId           String?
  affinityMode      String    @default("session")
  resolutionSource  String    @default("global_default")
  matchedRuleId     String?
  matchedRuleName   String?
  requestedSessionId String?
  resolvedSessionId  String?
  reused            Boolean   @default(false)
  status            String    @default("idle")
  parentSessionId   String?
  parentRunId       String?
  delegationDepth   Int       @default(0)
  lastRunStartedAt  DateTime?
  lastRunFinishedAt DateTime?
  lastHeartbeatAt   DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  childRuns ChildRun[]
  automationJobs GatewayAutomationJob[]
  automationRuns GatewayAutomationRun[]

  @@index([workspaceId, senderIdentifier, surfaceType])
  @@index([parentSessionId])
  @@map("session_bindings")
}

model ChildRun {
  id              String    @id @default(cuid())
  bindingId       String    @unique
  parentBindingId String?
  parentSessionId String
  parentRunId     String
  childSessionId  String
  agentId         String?
  workspaceId     String
  status          String    @default("queued")
  mode            String    @default("background")
  contextForkMode String    @default("recent")
  announceBackMode String   @default("summary")
  timeoutSeconds  Int?
  summary         String?
  fullOutput      String?
  sourcesJson     String?
  toolCallsJson   String?
  provenanceJson  String?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  binding SessionBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([parentSessionId])
  @@index([parentRunId])
  @@index([parentBindingId])
  @@map("child_runs")
}

model GatewayAutomationJob {
  id              String    @id @default(cuid())
  name            String
  kind            String
  status          String    @default("active")
  schedule        String
  prompt          String
  workspaceId     String    @default("default")
  agentId         String?
  sessionId       String?
  bindingId       String?
  surfaceType     String?
  senderIdentifier String?
  threadKey       String?
  channelKey      String?
  toolIds         String?
  model           String?
  contextForkMode String    @default("recent")
  maxConcurrency  Int       @default(1)
  timeoutSeconds  Int       @default(600)
  maxRetries      Int       @default(1)
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  metadataJson    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  runs            GatewayAutomationRun[]

  binding SessionBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt])
  @@index([workspaceId, agentId])
  @@map("gateway_automation_jobs")
}

model GatewayAutomationRun {
  id             String   @id @default(cuid())
  jobId          String
  bindingId      String?
  sessionId      String?
  agentId        String?
  status         String   @default("queued")
  attempt        Int      @default(1)
  summary        String?
  output         String?
  sourcesJson    String?
  toolCallsJson  String?
  provenanceJson String?
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  heartbeatAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job     GatewayAutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  binding SessionBinding?      @relation(fields: [bindingId], references: [id], onDelete: SetNull)

  @@index([jobId, status])
  @@index([bindingId])
  @@index([heartbeatAt])
  @@map("gateway_automation_runs")
}

model BindingRule {
  id               String   @id @default(cuid())
  name             String
  active           Boolean  @default(true)
  priority         Int      @default(100)
  workspaceId      String?
  surfaceType      String?
  senderIdentifier String?
  threadKey        String?
  channelKey       String?
  targetAgentId    String?
  affinityMode     String   @default("session")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, priority])
  @@index([workspaceId, surfaceType])
  @@map("binding_rules")
}

model ToolConfirmation {
  id          String    @id @default(cuid())
  sessionId   String
  toolName    String
  toolInput   String    // JSON stringified input
  status      String    @default("pending") // pending | approved | denied
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([sessionId])
  @@map("tool_confirmations")
}

model Message {
  id        String   @id @default(cuid())
  role      String
  content   String
  toolCalls String?  // Store as JSON string
  toolResults String? // Store as JSON string
  provenance String?  // Store as JSON string
  citations String?  // Store as JSON string
  
  // P1 Metadata
  modelId      String?
  isLocal      Boolean?
  fallbacks    String?  // JSON string array
  memoryRecall Boolean?
  agentId      String?
  errorType    String?
  errorMessage String?
  attachments  String? // JSON stringified ChatAttachment[]
  durationMs   Int?
  runIds       String?  // JSON string array of background task IDs
  promptPackId String?
  promptVersionHash String?
  reviewerPromptVersionHash String?
  workflowPromptIds String? // JSON string array
  branchId    String?
  parentMessageId String?
  branchSequence Int?

  createdAt DateTime @default(now())
  
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model TaskDefinition {
  id          String    @id @default(cuid())
  name        String
  description String
  agentId     String?
  toolIds     String    // JSON array of tool names
  schedule    String?   // cron expression or null
  workspaceId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  runs        TaskRun[]

  @@map("task_definitions")
}

model TaskRun {
  id              String          @id @default(cuid())
  definitionId    String
  definition      TaskDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  status          String          @default("queued")
  startedAt       DateTime?
  finishedAt      DateTime?
  selectedAgent   String?
  outputPath      String?
  provenance      String?         // JSON stringified ProvenanceTrace
  errorMessage    String?
  resumedFromRunId String?
  sessionId       String?
  promptPackId    String?
  promptVersionHash String?
  reviewerPromptVersionHash String?
  workflowPromptIds String?
  createdAt       DateTime        @default(now())
  steps           RunStep[]

  @@map("task_runs")
}

model RunStep {
  id          String   @id @default(cuid())
  runId       String
  run         TaskRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex   Int
  stepType    String   // plan | tool_call | tool_result | synthesis | error
  toolName    String?
  inputSummary  String?
  outputSummary String?
  sourceUrl   String?
  durationMs  Int?
  sandboxed   Boolean  @default(false)
  timestamp   DateTime @default(now())

  @@map("run_steps")
}

model ModelPreference {
  id          String   @id @default(cuid())
  modelId     String   @unique
  customName  String?
  isFavorite  Boolean  @default(false)
  provider    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("model_preferences")
}

model AgentProfile {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  systemPrompt String
  promptPackId String?
  promptOverlay String?
  status       String   @default("idle")
  isDefault    Boolean  @default(false)
  modelId      String?
  skills       String?  // JSON array of strings
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("agent_profiles")
}

model PromptImprovementProposal {
  id                        String   @id @default(cuid())
  sessionId                 String?
  messageId                 String?
  failureCategory           String
  promptPackId              String?
  promptVersionHash         String?
  reviewerPromptVersionHash String?
  workflowPromptIds         String?
  rationale                 String
  proposalJson              String
  expectedImprovement       String?
  status                    String   @default("pending")
  evalStatus                String   @default("pending")
  evalNotes                 String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([sessionId])
  @@index([promptPackId])
  @@map("prompt_improvement_proposals")
}

model McpServerConfig {
  id         String   @id @default(cuid())
  name       String   @unique
  type       String
  command    String
  args       String?  // JSON string array
  env        String?  // JSON object
  status     String   @default("stopped")
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("mcp_server_configs")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model HarnessRun {
  id             String   @id @default(cuid())
  name           String
  kind           String   @default("regression-pack")
  status         String   @default("running")
  modelId        String?
  workspace      String?
  metadataJson   String?
  summaryJson    String?
  artifactPaths  String?
  startedAt      DateTime @default(now())
  heartbeatAt    DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  processes      HarnessProcess[]

  @@index([status])
  @@map("harness_runs")
}

model HarnessProcess {
  id               String     @id @default(cuid())
  runId            String
  run              HarnessRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name             String
  suiteKey         String?
  status           String     @default("queued")
  commandJson      String
  pid              Int?
  outputLog        String?
  metadataJson     String?
  summaryJson      String?
  artifactPaths    String?
  startedAt        DateTime   @default(now())
  heartbeatAt      DateTime?
  finishedAt       DateTime?
  durationSeconds  Float?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([runId])
  @@index([status])
  @@map("harness_processes")
}

model MemoryEntry {
  id         String   @id @default(cuid())
  content    String
  tags       String?  // JSON string array
  source     String?
  collection String   @default("default")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([collection])
  @@map("memory_entries")
}

model Document {
  id            String   @id @default(cuid())
  filename      String
  mimeType      String
  extractedText String
  extractionMethod String @default("unknown")
  metadata      String?  // JSON stringified
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("documents")
}

model AppBuilderProject {
  id                        String                  @id @default(cuid())
  name                      String
  slug                      String                  @unique
  description               String?
  workspaceId               String                  @default("default")
  appType                   String                  @default("web_app")
  sourceType                String                  @default("generated")
  templateId                String?
  status                    String                  @default("draft")
  controlMode               String                  @default("observe_only")
  approvalRequired          Boolean                 @default(true)
  approvalGranted           Boolean                 @default(false)
  requestedPermissionsJson  String?
  requestedCapabilitiesJson String?
  sourcePath                String?
  managedPath               String?
  deployPath                String?
  exportPath                String?
  latestManifestId          String?
  latestRunId               String?
  metadataJson              String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  manifests                 AppBuilderManifest[]
  runs                      AppBuilderRun[]
  registryRecords           AppRegistryRecord[]
  adapters                  ImportedProjectAdapter[]

  @@index([workspaceId, status])
  @@map("app_builder_projects")
}

model AppBuilderManifest {
  id         String            @id @default(cuid())
  projectId  String
  version    String
  manifestJson String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  project    AppBuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("app_builder_manifests")
}

model AppBuilderRun {
  id          String            @id @default(cuid())
  projectId   String
  phase       String
  status      String            @default("queued")
  title       String
  summary     String?
  errorMessage String?
  gatewayRunId String?
  queueJobId  String?
  workerId    String?
  outputJson  String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     AppBuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([gatewayRunId])
  @@map("app_builder_runs")
}

model AppRegistryRecord {
  id                String             @id @default(cuid())
  projectId         String?
  appId             String
  version           String
  sourceType        String
  status            String             @default("pending")
  manifestJson      String
  controlEndpoint   String
  eventStreamEndpoint String
  deploymentLocation String?
  healthStatus      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  project           AppBuilderProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([appId, status])
  @@map("app_registry_records")
}

model ImportedProjectAdapter {
  id          String            @id @default(cuid())
  projectId   String
  adapterType String
  sourcePath  String
  outputPath  String?
  status      String            @default("draft")
  warningsJson String?
  metadataJson String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     AppBuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("imported_project_adapters")
}

model AppBuilderBlobRef {
  id          String   @id @default(cuid())
  workspaceId String
  blobHash    String
  snapshotId  String
  projectId   String
  filePath    String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, blobHash, snapshotId, filePath])
  @@index([workspaceId, blobHash])
  @@index([snapshotId])
  @@map("app_builder_blob_refs")
}
