{
  "servers": {
    "duckduckgo": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@oevortex/ddg_search"
      ],
      "url": null,
      "env": {}
    },
    "fetch": {
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/fetch"
      ],
      "url": null,
      "env": {}
    },
    "playwright": {
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/playwright"
      ],
      "url": null,
      "env": {}
    },
    "sequentialthinking": {
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/sequentialthinking"
      ],
      "url": null,
      "env": {}
    },
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users"
      ],
      "url": null,
      "env": {}
    },
    "google-search": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-google-search"
      ],
      "url": null,
      "env": {
        "GOOGLE_API_KEY": "",
        "GOOGLE_SEARCH_ENGINE_ID": ""
      }
    }
  }
}