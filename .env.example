# RawClaw Port Unification
# Ref: Blocker 4 (URL cleanup)

# API Gateway (NestJS)
API_PORT=3000
API_URL="http://localhost:3000"
DATABASE_URL="file:./apps/api/prisma/dev.db"

# Agent Subsystem (FastAPI)
AGENT_PORT=8000
AGENT_URL="http://localhost:8000"
RAWCLAW_AGENT_BIND_HOST="127.0.0.1"
RAWCLAW_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Sandbox Configuration (Blocker 3)
SANDBOX_DOCKER_IMAGE="python:3.11-slim"
SANDBOX_WORKSPACE_DIR="/tmp/rawclaw-sandbox"
LOG_LEVEL="INFO"

# Vector Store (ChromaDB)
CHROMA_SERVER_HOST="localhost"
CHROMA_SERVER_HTTP_PORT=8000

# Cache / Queue
REDIS_URL="redis://localhost:6379"

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
RAWCLAW_AUDIT_LOG_PATH="./logs/audit/memory-retrieval.log"
RAWCLAW_WORKER_METRICS_PORT=9090

# Inference protection
RAWCLAW_CHAT_RATE_LIMIT_PER_MINUTE=20
RAWCLAW_DAILY_TOKEN_LIMIT=100000

# Memory retrieval quality policy
# JSON example:
# RAWCLAW_COLLECTION_CONFIG='{"default":{"max_distance":0.25,"similarity_floor":0.75}}'

# Search & Fetch
BRAVE_API_KEY=""

# Agent reasoning safety limits
MAX_SEQUENTIAL_THINKING_TURNS=10  # Max reasoning-tool turns before forcing action

# Security
JWT_SECRET="PLEASE_CHANGE_ME_TO_A_LONG_RANDOM_STRING"
AUTH_SECRET="A_STRONG_SECRET_FOR_BOOTSTRAP"
ALLOW_LOCAL_AUTH="true"
ENCRYPTION_KEY="32-CHAR-HEX-KEY-FOR-VAULT"

# LLM Providers (Ollama-Only Mode)
OLLAMA_BASE_URL="http://localhost:11434"
# Example IDs for routing:
# DEFAULT_LOW_MODEL="ollama/gemma4:e4b"
# DEFAULT_MEDIUM_MODEL="ollama/gemma4:31b-cloud"
# DEFAULT_HIGH_MODEL="ollama/gemma4:31b-cloud"
# Support for cloud-backed models:
# DEFAULT_CLOUD_MODEL="ollama/qwen3-coder:480b-cloud"
DOCKER_MCP_TRANSPORT="stdio"
DOCKER_MCP_PROFILE=""
DOCKER_MCP_URL="http://localhost:8811"
# Turborepo (disable git hashing on Windows)
TURBO_FORCE_GIT=0
